# CRO Analyzer Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: Anthropic API
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for PDP analysis (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8
# MAX_TOKENS=8000

# ============================================
# API security (recommended for production)
# ============================================
# If set, POST /analyze and /analyze/async require this value
# in the X-API-Key header. Leave empty to disable auth (local dev).
API_AUTH_KEY=

# Max analysis submissions per client IP per minute (0 = disabled)
RATE_LIMIT_PER_MINUTE=10

# ============================================
# Knowledge grounding (3-tier chain of command)
# Tier 1: proprietary audit patterns (Notion library -> Qdrant)
# Tier 2: CRO knowledge brain (existing Qdrant collection)
# Tier 3: built-in expert rubric (always available)
# Feature is OFF (tier 3 only) unless QDRANT_URL + EMBEDDING_API_KEY are set.
# ============================================
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_AUDIT_COLLECTION=taurist_audit_patterns
# QDRANT_KNOWLEDGE_COLLECTION=slash_cro_knowledge

# Embedding API used for queries + audit-collection ingestion
# EMBEDDING_PROVIDER=openai            # openai | voyage
EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small   # matches slash_cro_knowledge

# slash_cro_knowledge is embedded with text-embedding-3-small (the default
# above), so no KNOWLEDGE_EMBEDDING_* overrides are needed. Set them only if
# the collections ever diverge:
# KNOWLEDGE_EMBEDDING_PROVIDER=
# KNOWLEDGE_EMBEDDING_MODEL=
# KNOWLEDGE_EMBEDDING_API_KEY=

# Retrieval tuning
# AUDIT_SCORE_THRESHOLD=0.40
# KNOWLEDGE_SCORE_THRESHOLD=0.40
# GROUNDING_MAX_SNIPPETS=10
# GROUNDING_TIMEOUT_SECONDS=8

# ============================================
# Redis / Celery (async mode)
# ============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Concurrent analyses per worker container
CELERY_WORKER_CONCURRENCY=5

# ============================================
# Analysis time budget
# ============================================
# Per-attempt budget for one full analysis (seconds). One retry on timeout.
# ANALYSIS_TIMEOUT=150
# Playwright navigation timeout in ms (domcontentloaded)
# NAV_TIMEOUT_MS=45000

# ============================================
# Browser runtime (per worker process)
# ============================================
# Each worker process keeps one Chromium alive, recycled after N analyses
# BROWSER_MAX_USES=20
# BROWSER_MAX_AGE_SECONDS=1800

# ============================================
# Cache
# ============================================
# Analysis result cache TTL in seconds (default 24h)
CACHE_TTL=86400

# ============================================
# Deployment
# ============================================
WORKER_MODE=false
API_WORKERS=2
LOG_LEVEL=INFO
